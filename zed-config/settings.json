// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_scan_exclusions": [
    "**/.cursor",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/slop-scan.config.json",
    "**/.cursorrules",
    "..."
  ],
  "terminal": {
    "bell": "off"
  },
  "minimap": {
    "show": "always"
  },
  "file_types": {
    "html": [
      "*.embeddedhtml"
    ],
    "markdown": [
      "*.rmd"
    ]
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "latex": true
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "C:/Users/bootcamp/AppData/Local/SumatraPDF/SumatraPDF.exe",
            "args": ["-reuse-instance", "%p", "-forward-search", "%f", "%l"]
          }
        }
      }
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
